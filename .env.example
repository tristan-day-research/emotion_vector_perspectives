# Copy to .env and fill in. Never commit .env.
# Loaded manually (e.g. `set -a; source .env; set +a`) or exported in your RunPod pod.

# --- Hugging Face ---
HF_TOKEN=
# Keep the HF cache off the container root disk on RunPod (point at a volume):
HF_HOME=/workspace/hf_cache

# --- Cloudflare R2 (S3-compatible) ---
# Used by core/r2.py when config.r2_sync = True.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=emotion-vector-activations
# Optional: overrides the endpoint derived from R2_ACCOUNT_ID
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

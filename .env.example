# Copy to .env and fill in. Never commit .env.
# Loaded manually (e.g. `set -a; source .env; set +a`) or exported in your RunPod pod.

# --- Hugging Face ---
HF_TOKEN=
# Keep the HF cache off the container root disk on RunPod (point at a volume):
HF_HOME=/workspace/hf_cache

# --- Cloudflare R2 (S3-compatible) ---
# Only needed for LOCAL R2 access from your Mac. On the pod, run-emotionvectors
# forwards scripts/r2.env instead, so you do not maintain this twice --
# scripts/r2.env is the single source of truth. Keep this file for a local
# `python run.py r2 pull` when scripts/r2.env is not on your PATH.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=emotion-vector-perspectives
# R2_ACCOUNT_ID also works instead of R2_ENDPOINT (endpoint is derived from it).

# Story activations land at:
#   s3://emotion-vector-perspectives/story-activations/<run_name>/
# controlled by config.r2_root / config.r2_prefix.

# Template for r2.env -- the ONE file that carries this project's credentials.
#
#   cp r2.env.example r2.env     # then fill in the blanks
#   python run.py r2 check       # confirms bucket + endpoint, names the file used
#
# r2.env is git-ignored. Never commit it, and never paste its contents into
# Slack, email, or an issue. To give a teammate access, run
# ./share_with_teammate.sh -- it mints per-person, read-only instructions.
#
# Everything in this repo loads r2.env automatically (core/env_file.py), so there
# is no `source` step. The file also stays valid shell, so `set -a; . r2.env;
# set +a` works if you want the variables in your own shell.

# --- Cloudflare R2 (S3-compatible) -------------------------------------------
# Endpoint: Cloudflare dashboard -> R2 -> Overview -> "S3 API" (or use your
# account id, from which the endpoint is derived).
export R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# Token: R2 -> Manage R2 API Tokens -> Create API Token.
#   Object Read & Write   for whoever runs extraction
#   Object Read only      for teammates who only pull activations
# Scope it to the bucket below and nothing else.
export R2_ACCESS_KEY_ID=""
export R2_SECRET_ACCESS_KEY=""

# This project's bucket. Do not point it at another project's bucket: extraction
# writes ~8 GiB of activations under story-activations/<run_name>/ here.
export R2_BUCKET="emotion-vector-perspectives"

# --- Hugging Face -------------------------------------------------------------
# Only needed for gated checkpoints. The default Qwen2.5-32B is not gated, so an
# empty value is fine.
export HF_TOKEN=""

# --- Optional: mirror to AWS_* so the `aws` CLI works with no extra flags -----
# R2 ignores the region, but the CLI insists one is set.
# export AWS_ENDPOINT_URL="$R2_ENDPOINT"
# export AWS_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID"
# export AWS_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY"
# export AWS_DEFAULT_REGION="auto"

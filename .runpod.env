# Per-project overrides for the shared ../scripts/ RunPod workflow.
# See ../scripts/runpod.env.example for the full list of knobs.

REQUIREMENTS_FILE="requirements.txt"
INSTALL_CMD="pip install -r $REQUIREMENTS_FILE"
RUN_ENTRYPOINT="HF_HOME=/workspace/hf_cache PYTHONUNBUFFERED=1 python run.py"
RESULTS_SUBDIR="outputs"

# activations/ is large (potentially 8+ GiB) and meant to stay pod/R2-only
# (see r2_sync in vector_extraction_config.py) — never pull it to the Mac.
RESULTS_EXCLUDE="activations/"
